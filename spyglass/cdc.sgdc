#===============================================================================
# SpyGlass Design Constraints (SGDC) for CDC Analysis
# Design: top
#===============================================================================

current_design "top"

# 1. Define Clock Domains
clock -name "i_top_cxs_clk" -domain CXS_DOMAIN -period 27.027 -edge {0 13.5135}
clock -name "i_top_sys_clk" -domain SYS_DOMAIN -period 40.0   -edge {0 20.0}

# 2. Define Primary Asynchronous Resets
reset -name "i_top_cxs_rst_n" -value 0
reset -name "i_top_sys_rst_n" -value 0

# 3. Constrain Primary Input/Output Ports to their respective Clock Domains
input -name "i_top_cxs_rx_valid"  -clock "i_top_cxs_clk"
input -name "i_top_cxs_rx_data"   -clock "i_top_cxs_clk"
input -name "i_top_cxs_rx_cntl"   -clock "i_top_cxs_clk"
input -name "i_top_cxs_tx_crdgnt" -clock "i_top_cxs_clk"

output -name "o_top_cxs_rx_crdgnt" -clock "i_top_cxs_clk"
output -name "o_top_cxs_tx_valid"  -clock "i_top_cxs_clk"
output -name "o_top_cxs_tx_data"   -clock "i_top_cxs_clk"
output -name "o_top_cxs_tx_cntl"   -clock "i_top_cxs_clk"

# 4. Standard Waivers (Unsynchronized crossings handled by FIFO & reset pads)
waive -rule "Ac_unsync01"
waive -rule "Ac_unsync02"
waive -rule "Ar_unsync01"
waive -rule "Setup_port01"
